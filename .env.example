# The storefront runs without credentials; the database catalog is enabled in Phase 3.
# Copy to .env.local; never commit real secrets.
# Database, Auth, Cloudinary and sandbox payment tooling are implemented. Order email is Phase 8.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# PostgreSQL runtime pooler (transaction mode); introduced in Phase 3.
DATABASE_ENABLED=false
DATABASE_URL=
# Migration/CI-only direct or session-pooler URL. Do not give runtime DDL credentials.
DIRECT_URL=
CATALOG_ALLOW_SAMPLES=false
# Isolated LOCAL test targets; test-database.ts resets commerce and migration history in sd_catalog_test.
TEST_DATABASE_URL=
TEST_READER_URL=
TEST_ACCOUNT_DATABASE_URL=
TEST_COMMERCE_DATABASE_URL=
TEST_PAYMENT_DATABASE_URL=
TEST_ADMIN_DATABASE_URL=
# Phase 7: restricted administration writer; grants still require operator provisioning and MFA.
ADMIN_DATABASE_URL=

# Supabase public URL and publishable key; introduced in Phase 4.
AUTH_ENABLED=false
GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Separate restricted account writer; never use DIRECT_URL or the catalog reader here.
ACCOUNT_DATABASE_URL=
# At least 32 random characters; server only, used to hash rate-limit identities and sign recovery proof.
AUTH_RATE_LIMIT_SECRET=
# Phase 5: separate restricted commerce writer, never an owner/account/catalog credential.
CART_ENABLED=false
COMMERCE_DATABASE_URL=
# Test orders only; rejected outside APP_ENV=development/test. Requires carts and Auth.
LOCAL_CHECKOUT_ENABLED=false
# Operator-only SUPABASE_ADMIN_KEY is needed ONLY by admin:provision. Never set it in app runtime.

# Signed image uploads; introduced in Phase 3.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email; introduced in Phase 8. Use bare email addresses here.
EMAIL_ENABLED=false
EMAIL_CAPTURE_ENABLED=false
COMMUNICATIONS_DATABASE_URL=
TEST_COMMUNICATIONS_DATABASE_URL=
RESEND_WEBHOOK_SECRET=
COMMUNICATIONS_WORKER_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Phase 6 ledger: separate restricted payment processor credential.
PAYMENTS_ENABLED=false
PAYMENT_DATABASE_URL=
# Sandbox only. Live mode is rejected even when this flag is false.
PAYFAST_ENABLED=false
PAYFAST_INSTANT_EFT_ENABLED=false
PAYFAST_TRUSTED_PROXY=none
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Enable only with owner-approved details. Local test orders never request a real transfer.
MANUAL_EFT_ENABLED=false
MANUAL_EFT_BANK_NAME=
MANUAL_EFT_ACCOUNT_NAME=
MANUAL_EFT_ACCOUNT_NUMBER=
MANUAL_EFT_BRANCH_CODE=
