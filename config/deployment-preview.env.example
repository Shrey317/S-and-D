# First credential-free hosted preview only. Not a production commerce configuration.
# Replace with the exact assigned site origin before checking/building.
APP_ENV=preview
NEXT_PUBLIC_SITE_URL=https://replace-before-deployment.invalid
NEXT_TELEMETRY_DISABLED=1
DATABASE_ENABLED=false
CATALOG_ALLOW_SAMPLES=false
AUTH_ENABLED=false
GOOGLE_AUTH_ENABLED=false
CART_ENABLED=false
LOCAL_CHECKOUT_ENABLED=false
CLOUDINARY_ENABLED=false
EMAIL_ENABLED=false
EMAIL_CAPTURE_ENABLED=false
PAYMENTS_ENABLED=false
PAYFAST_ENABLED=false
PAYFAST_INSTANT_EFT_ENABLED=false
MANUAL_EFT_ENABLED=false
PAYFAST_MODE=sandbox
PAYFAST_TRUSTED_PROXY=none
